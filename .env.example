# Copy this file to .env and replace all values before use.
JWT_SECRET=replace-with-a-long-random-secret-before-running
LOCAL_PIN=replace-with-a-private-6-to-12-digit-pin
LOCAL_USER_EMAIL=owner@trackguard.local
LOCAL_USER_NAME=TrackGuard Owner
LOCAL_USER_PHONE=
SUPER_ADMIN_PHONE=
TOTP_ENCRYPTION_KEY=
PHONE_RECOVERY_HMAC_KEY=replace-with-at-least-32-random-characters

# Optional, but required for phone ownership verification and SMS recovery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Local development uses SQLite by default. Docker Compose overrides this
# with the PostgreSQL URL; set POSTGRES_PASSWORD for the PostgreSQL container.
DATABASE_URL=sqlite+aiosqlite:///./trackguard.db
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
